# Copy to .env.local and fill in. Never commit real values. See docs/SPEC.md §13.

# Claude (Ask PSI). An Anthropic key (sk-ant-...) calls the Anthropic API directly; an
# OpenRouter key (sk-or-...) is detected and routed through OpenRouter's Anthropic-compatible
# endpoint (model id converted, e.g. claude-opus-5-5 -> anthropic/claude-opus-5.5).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low
# ANTHROPIC_BASE_URL=https://openrouter.ai/api   # optional override

# Embeddings only
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Supabase (server-only keys)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# Only needed for the Supabase CLI (migrations), not by the app
SUPABASE_DB_PASSWORD=

# RAG / abuse / cost
RAG_MIN_SIMILARITY=0.3
RATE_LIMIT_PER_HOUR=30
DAILY_MESSAGE_CAP=1500
IP_HASH_SALT=

# Feature flags
FEATURE_SCENARIO=false

NEXT_PUBLIC_SITE_URL=http://localhost:3000
